{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expgym.local/schemas/trace-v2.schema.json",
  "title": "ExpGym Trace v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trace_id",
    "provenance",
    "run",
    "task",
    "messages",
    "llm_calls",
    "tool_calls",
    "outcome",
    "timing"
  ],
  "properties": {
    "schema": {
      "enum": [{"name": "expgym.trace", "version": "2.0.0"}, {"name": "expgym.trace", "version": "2.1.0"}]
    },
    "trace_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object", "properties": {
        "repository": {"type": "object"}, "environment": {"type": "object"},
        "created_at": {"type": "string"}, "runner": {"type": "string"}
      }
    },
    "run": {
      "type": "object", "properties": {
        "backend": {"type": "object"}, "model": {"type": "object"},
        "generation": {"type": "object"}, "transport": {"type": "object"},
        "prompt_cache": {"type": "object"}, "api_dump": {"type": "object"},
        "protocol": {
          "type": "object", "properties": {
            "tool_protocol": {"enum": ["auto", "native", "text"]},
            "tuning_final_policy": {"enum": ["submitted", "legacy"]},
            "max_protocol_retries": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "task": {
      "type": "object", "properties": {
        "scenario": {"enum": ["tuning", "restricted_search", "evidence_audit"]},
        "item": {"type": "object"}, "dataset": {"type": "object"},
        "budget": {
          "type": "object", "properties": {
            "regime": {"enum": ["cost_free", "cost_moderate", "cost_tight", null]},
            "mode": {"type": ["string", "null"]},
            "base_cost_seconds": {"type": ["number", "null"], "minimum": 0},
            "limit_seconds": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "limits": {
          "type": "object", "properties": {
            "max_steps": {"$ref": "#/$defs/tokenCount"},
            "max_evaluations": {"$ref": "#/$defs/tokenCount"},
            "max_prompt_tokens": {"$ref": "#/$defs/tokenCount"},
            "max_context_tokens": {"$ref": "#/$defs/tokenCount"}
          }
        },
        "rep": {"type": "integer", "minimum": 0},
        "hypothesis_order": {"type": "array", "items": {"type": "string"}}
      }
    },
    "messages": {
      "type": "array",
      "items": {"$ref": "#/$defs/message"}
    },
    "llm_calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/llmCall"}
    },
    "tool_calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/toolCall"}
    },
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "termination_reason",
        "answer_source",
        "answer_message_id",
        "score",
        "validation"
      ],
      "properties": {
        "status": {"enum": ["completed", "terminated"]},
        "termination_reason": {"enum": ["natural_answer", "time_budget_exceeded", "max_evaluations_reached", "max_steps_reached", "prompt_token_budget_exceeded", "context_token_budget_exceeded", "empty_model_response", "missing_action", "unknown_tool", "protocol_error", "aborted"]},
        "answer_source": {"enum": ["natural_model_answer", "forced_model_answer", "best_evaluated_fallback", null]},
        "answer": {"type": ["string", "null"]},
        "answer_overhead": {"type": ["number", "null"], "minimum": 0},
        "answer_override": {"type": ["string", "null"]},
        "answer_message_id": {"type": ["string", "null"]},
        "answer_score_source": {"enum": ["offline_final_answer", "offline_empty_prediction", "answer_evaluator", "matching_tool_call", "best_evaluated_fallback", "unscored", null]},
        "missing_final_policy": {"const": "task-abstention-v1"},
        "terminal_origin": {"const": "normal_loop_return"},
        "terminal_scenario": {"enum": ["tuning", "restricted_search", "evidence_audit"]},
        "scoring_input": {"type": ["string", "null"]},
        "score_status": {"enum": ["scored_final_answer", "scored_empty_prediction", "unscorable_missing_configuration"]},
        "terminal_status": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "policy_version", "execution_complete", "score_complete", "terminal_classification", "model_no_answer_count", "expected_model_terminals", "reported_model_terminals"],
          "properties": {
            "schema_version": {"const": "expgym.execution-terminal.v1"},
            "policy_version": {"const": "task-abstention-v1"},
            "execution_complete": {"const": true}, "score_complete": {"type": "boolean"},
            "terminal_classification": {"enum": ["completed_scored", "model_no_answer"]},
            "model_no_answer_count": {"type": "integer", "minimum": 0, "maximum": 1},
            "expected_model_terminals": {"const": 1}, "reported_model_terminals": {"const": 1}
          }
        },
        "score_cost_basis": {"enum": ["total_simulated_cost", "matching_tool_call", "offline_final_answer", "unscored_terminal"]},
        "tool_protocol": {"enum": ["native", "text"]},
        "tuning_final_policy": {"enum": ["submitted", "legacy"]},
        "protocol_failures": {"type": "array", "items": {
          "type": "object", "required": ["agent_step", "llm_call_index", "forced", "reason", "finish_reason"],
          "properties": {
            "agent_step": {"type": "integer", "minimum": 0},
            "llm_call_index": {"type": "integer", "minimum": 1},
            "forced": {"type": "boolean"}, "reason": {"type": "string"},
            "finish_reason": {"type": ["string", "null"]}
          }
        }},
        "protocol_retries": {"type": "integer", "minimum": 0},
        "agent_steps": {"type": "integer", "minimum": 0},
        "http_request_attempts": {"type": "integer", "minimum": 0},
        "score": {
          "type": "object",
          "oneOf": [
            {"required": ["value"], "not": {"required": ["metrics"]}},
            {"required": ["metrics", "primary_metric"], "not": {"required": ["value"]}}
          ],
          "properties": {
            "value": {"type": ["number", "null"]},
            "primary_metric": {"type": "string", "minLength": 1},
            "metrics": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
          }
        },
        "validation": {
          "type": "object", "required": ["passed", "method"],
          "properties": {"passed": {"type": "boolean"}, "method": {"enum": ["repository_score_recompute", "explicit_model_terminal_unscored"]}}
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["wall_time_seconds"],
      "properties": {
        "wall_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "total_simulated_cost_seconds": {"type": "number", "minimum": 0},
        "llm_latency_seconds": {"type": "number", "minimum": 0},
        "tool_simulated_cost_seconds": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "tokenCount": {"type": ["integer", "null"], "minimum": 0},
    "wireMessage": {
      "type": "object", "required": ["role"],
      "properties": {
        "role": {"enum": ["system", "developer", "user", "assistant", "tool", "function"]},
        "content": {"type": ["string", "array", "null"]},
        "reasoning_content": {"type": ["string", "null"]},
        "tool_calls": {"type": ["array", "null"]},
        "tool_call_id": {"type": "string"}, "name": {"type": "string"}
      }
    },
    "attemptUsage": {
      "type": "object", "required": ["attempt", "state", "http_status", "usage"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "state": {"enum": ["error", "malformed_response", "success"]},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "usage": {"type": ["object", "null"]}
      }
    },
    "message": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/wireMessage"}],
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "content": {"type": ["string", "array", "null"]},
        "content_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tool_call_id"],
          "properties": {
            "kind": {"const": "tool_observation"},
            "tool_call_id": {"type": "string", "minLength": 1}
          }
        },
        "request_only": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["content"], "not": {"required": ["content_ref"]}},
        {"required": ["content_ref"], "not": {"required": ["content"]}},
        {"properties": {"role": {"const": "assistant"}}, "not": {"anyOf": [{"required": ["content"]}, {"required": ["content_ref"]}]}}
      ]
    },
    "llmCall": {
      "type": "object",
      "required": [
        "id",
        "input_message_ids",
        "output_message_id",
        "forced",
        "latency_seconds",
        "request_attempts",
        "usage"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input_message_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "output_message_id": {"type": ["string", "null"]},
        "forced": {"type": "boolean"},
        "latency_seconds": {"type": "number", "minimum": 0},
        "request_attempts": {"type": "integer", "minimum": 1},
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "cache"],
          "properties": {
            "input_tokens": {"$ref": "#/$defs/tokenCount"}, "output_tokens": {"$ref": "#/$defs/tokenCount"},
            "cache": {
              "type": "object", "required": ["reported", "read_tokens", "write_tokens"],
              "properties": {
                "reported": {"type": "boolean"},
                "read_tokens": {"$ref": "#/$defs/tokenCount"}, "write_tokens": {"$ref": "#/$defs/tokenCount"}
              }
            }
          }
        },
        "raw_output": {"type": ["string", "null"]},
        "output_message": {"$ref": "#/$defs/wireMessage"},
        "finish_reason": {"type": ["string", "null"]},
        "attempt_usage": {"type": "array", "items": {"$ref": "#/$defs/attemptUsage"}}
      }
    },
    "toolCall": {
      "type": "object",
      "required": [
        "id",
        "request_message_id",
        "result_message_id",
        "name",
        "arguments",
        "performance",
        "simulated_cost_seconds",
        "visible_to_model"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "request_message_id": {"type": "string", "minLength": 1},
        "result_message_id": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "arguments": {},
        "raw_arguments": {"type": "string"},
        "canonical_argument": {"type": ["string", "null"]},
        "included_in_eval_records": {"type": "boolean"},
        "tool_result": {},
        "performance": {"type": ["number", "null"]},
        "simulated_cost_seconds": {"type": "number", "minimum": 0},
        "visible_to_model": {"type": "boolean"},
        "response_kind": {"enum": ["observation", "withheld_notice"]},
        "observation": {"type": "string"},
        "withheld_result": {},
        "structured_result": {}
      }
    }
  }
}
