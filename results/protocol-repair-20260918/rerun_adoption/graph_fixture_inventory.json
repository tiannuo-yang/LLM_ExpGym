    "default_sections": [
      "=== Evaluated Configs ===",
      "=== Best So Far ==="
    ],
    "strategy_expectation": "naive and cached have no graph messages and should be checked as not-applicable, not as missing/corrupt graph",
    "self_loops": "A self-loop is valid when a genuinely repeated identical canonical config is evaluated; prohibit ambiguous/colliding IDs, not all self-loops.",
