    "command": "LLM_ExpGym/.venv/bin/python - <<'PY'\nimport datetime, hashlib, json, os, pathlib, stat\nbefore_path = pathlib.Path(\"/lustrefs/users/chufan.shi/codex_space_tn/kimi_k3_eval/data_runtime/validation_v3/evidence_v2_preserved_before.json\")\nbefore_bytes = before_path.read_bytes()\nbefore = json.loads(before_bytes)\nroot = pathlib.Path(before[\"root\"])\ndef scan():\n    found = []\n    for base, dirs, names in os.walk(str(root), followlinks=False):\n        for name in dirs:\n            if (pathlib.Path(base) / name).is_symlink():\n                raise RuntimeError(\"Unexpected symlink directory: \" + str(pathlib.Path(base) / name))\n        for name in names:\n            found.append(pathlib.Path(base) / name)\n    return sorted(found)\npaths = scan()\nfiles = []\nfor path in paths:\n    first = path.stat()\n    if not stat.S_ISREG(first.st_mode):\n        raise RuntimeError(\"Not a regular file: \" + str(path))\n    h = hashlib.sha256()\n    with path.open(\"rb\") as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b\"\"):\n            h.update(block)\n    last = path.stat()\n    if (first.st_size, first.st_mtime_ns, first.st_ino) != (last.st_size, last.st_mtime_ns, last.st_ino):\n        raise RuntimeError(\"Concurrent file mutation: \" + str(path))\n    files.append({\"path\": str(path.relative_to(root)), \"bytes\": first.st_size, \"sha256\": h.hexdigest()})\nif paths != scan():\n    raise RuntimeError(\"Concurrent file set change\")\nold = {item[\"path\"]: item for item in before[\"files\"]}\nnew = {item[\"path\"]: item for item in files}\nadded = sorted(set(new) - set(old))\nremoved = sorted(set(old) - set(new))\nchanged = [{\"path\": path, \"before\": old[path], \"after\": new[path]} for path in sorted(set(old) & set(new)) if old[path] != new[path]]\ncanonical = json.dumps(files, sort_keys=True, separators=(\",\", \":\")).encode()\nreport = {\n    \"classification\": \"Static/fake validation\",\n    \"checked_at_utc\": date