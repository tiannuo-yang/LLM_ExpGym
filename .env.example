# Copy to .env or export these variables in your shell.

# Either set the key directly or point at a one-line key file.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_KEY_FILE=../openrouter.key

# Sub2API (source /path/to/sub2api/.sub2api-client.env instead when using a
# local deployment; do not commit the real key).
# SUB2API_BASE_URL=http://127.0.0.1:8080
# SUB2API_API_KEY=sk-...
# SUB2API_MODEL=gpt-5.3-codex-spark

# Direct OpenAI-compatible API.
# OPENAI_API_KEY=sk-...
# EXPGYM_OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible server override. Both base URLs and full
# /chat/completions endpoints are accepted.
# EXPGYM_BASE_URL=http://localhost:8000/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional cache namespace. The sweep derives a distinct <=64-character key
# per job and keeps it unchanged across every turn and retry in that job.
# EXPGYM_PROMPT_CACHE_KEY=expgym-paper-v1
# EXPGYM_PROMPT_CACHE_SCOPE=job

# Versioned normalized trace format. Set v1 only for legacy consumers.
EXPGYM_TRACE_FORMAT=v2

# Optional data locations. If unset, scripts use ./data/ under this repo.
# EXPGYM_DATA_ROOT=/absolute/path/to/expgym-data
# PHANTOM_WIKI_ROOT=/absolute/path/to/expgym-data/phantom-wiki

# Optional offline ContractNLI zip override. Normally this is not needed:
# `--with-auto-data` downloads the official GitHub-hosted zip automatically.
# CONTRACT_NLI_ARCHIVE=/absolute/path/to/contract-nli.zip

# Optional offline directory containing the six pinned ParamNet .pkl files.
# Normal setup downloads and verifies them automatically.
# HPOBENCH_SURROGATES_DIR=/absolute/path/to/paramnet-surrogates

# Optional offline HPOBench overrides. Files are size/checksum verified.
# HPOBENCH_NASBENCH101_FILE=/absolute/path/to/nasbench_full.tfrecord
# HPOBENCH_NATS_TSS_ARCHIVE=/absolute/path/to/NATS-tss-v1_0-3ffb9-simple.tar

# Default low-cost smoke model.
EXPGYM_OPENROUTER_MODEL=openai/gpt-4.1-nano
